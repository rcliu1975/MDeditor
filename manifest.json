{
  "name": "MD Editor",
  "short_name": "MD Editor",
  "description": "ChatGPT-style Markdown Editor PWA",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#212121",
  "theme_color": "#212121",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/markdown": [".md", ".markdown"]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [".md", ".markdown", "text/markdown"]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "navigate-new"
  }
}
